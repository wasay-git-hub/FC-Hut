# Gemini API Key (Get free key from https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Meta WhatsApp Cloud API credentials (needed when connecting to real WhatsApp)
# Leave blank for local terminal simulation mode
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
